    {
      "id": "dev-09",
      "prompt": "Replace all numbers in \"Hello 34 I'm 233 years old\" with NUMBERS",
      "expected_name": "fn_substitute_string_with_regex",
      "expected_parameters": {
        "source_string": "Hello 34 I'm 233 years old",
        "regex": "\\d+",
        "replacement": "NUMBERS"
      },
      "regex_checks": [
        {
          "input": "Hello 34 I'm 233 years old",
          "output": "Hello NUMBERS I'm NUMBERS years old"
        },
        {
          "input": "A7B40",
          "output": "ANUMBERSBNUMBERS"
        },
        {
          "input": "no digits",
          "output": "no digits"
        }
      ]
    },
    {
      "id": "dev-10",
      "prompt": "Replace all vowels in 'Programming is fun' with asterisks",
      "expected_name": "fn_substitute_string_with_regex",
      "expected_parameters": {
        "source_string": "Programming is fun",
        "regex": "[aeiouAEIOU]",
        "replacement": "*"
      },
      "regex_checks": [
        {
          "input": "Programming is fun",
          "output": "Pr*gr*mm*ng *s f*n"
        },
        {
          "input": "AEIOU",
          "output": "*****"
        },
        {
          "input": "xyz",
          "output": "xyz"
        }
      ]
    },
    {
      "id": "dev-11",
      "prompt": "Substitute the word 'cat' with 'dog' in 'The cat sat on the mat with another cat'",
      "expected_name": "fn_substitute_string_with_regex",
      "expected_parameters": {
        "source_string": "The cat sat on the mat with another cat",
        "regex": "cat",
        "replacement": "dog"
      },
      "regex_checks": [
        {
          "input": "The cat sat on the mat with another cat",
          "output": "The dog sat on the mat with another dog"
        },
        {
          "input": "catfish",
          "output": "dogfish"
        },
        {
          "input": "dog",
          "output": "dog"
        }
      ]
    }
  ]
