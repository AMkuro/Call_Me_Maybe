      "returns": {
        "type": "string"
      }
    },
    {
      "name": "fn_get_cube",
      "description": "Calculate the cube of a number.",
      "parameters": {
        "a": {
          "type": "number"
        }
      },
      "returns": {
        "type": "number"
      }
    },
    {
      "name": "fn_replace_matches",
      "description": "Replace all occurrences matching a regex pattern in a string.",
      "parameters": {
        "source_string": {
          "type": "string"
        },
        "regex": {
          "type": "string"
        },
        "replacement": {
          "type": "string"
        }
      },
      "returns": {
        "type": "string"
      }
    }
  ],
  "cases": [
    {
      "id": "difference-01",
      "prompt": "What is 19 minus 4?",
      "expected_name": "fn_subtract_numbers",
      "expected_parameters": {
        "a": 19,
        "b": 4
      }
    },
    {
      "id": "difference-02",
      "prompt": "Subtract 15 from 60.",
      "expected_name": "fn_subtract_numbers",
      "expected_parameters": {
        "a": 60,
        "b": 15
      }
    },
    {
      "id": "difference-03",
      "prompt": "Calculate 92 minus 27.",
      "expected_name": "fn_subtract_numbers",
      "expected_parameters": {
        "a": 92,
        "b": 27
      }
    },
    {
      "id": "difference-04",
      "prompt": "Greet Olivia.",
