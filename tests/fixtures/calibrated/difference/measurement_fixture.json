      "prompt": "What is the cube of 3?",
      "expected_name": "fn_get_cube",
      "expected_parameters": {
        "a": 3
      }
    },
    {
      "id": "difference-08",
      "prompt": "Find the cube of 8.",
      "expected_name": "fn_get_cube",
      "expected_parameters": {
        "a": 8
      }
    },
    {
      "id": "difference-09",
      "prompt": "Replace all numbers in 'Unit 5, row 21' with '#'.",
      "expected_name": "fn_replace_matches",
      "expected_parameters": {
        "source_string": "Unit 5, row 21",
        "regex": "\\d+",
        "replacement": "#"
      },
      "regex_checks": [
        {
          "input": "Unit 5, row 21",
          "output": "Unit #, row #"
        },
        {
          "input": "A2B17",
          "output": "A#B#"
        },
        {
          "input": "plain",
          "output": "plain"
        }
      ]
    },
    {
      "id": "difference-10",
      "prompt": "Replace all vowels in 'Music Room' with '*'.",
      "expected_name": "fn_replace_matches",
      "expected_parameters": {
        "source_string": "Music Room",
        "regex": "[aeiouAEIOU]",
        "replacement": "*"
      },
      "regex_checks": [
        {
          "input": "Music Room",
          "output": "M*s*c R**m"
        },
        {
          "input": "AEIOU",
          "output": "*****"
        },
        {
          "input": "sky",
          "output": "sky"
        }
      ]
    },
    {
      "id": "difference-11",
      "prompt": "Replace every 'sun' with 'moon' in 'sun at sunset'.",
      "expected_name": "fn_replace_matches",
      "expected_parameters": {
        "source_string": "sun at sunset",
        "regex": "sun",
        "replacement": "moon"
      },
      "regex_checks": [
        {
          "input": "sun at sunset",
          "output": "moon at moonset"
        },
        {
          "input": "sunglasses",
          "output": "moonglasses"
        },
        {
          "input": "SUN",
          "output": "SUN"
        }
      ]
    }
  ]
}
