{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/Qwen/Qwen3.5-9B",
  "small_model": "local/Qwen/Qwen3.5-9B",
  "enabled_providers": [
    "local"
  ],
  "share": "disabled",
  "autoupdate": false,
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local GPU optimizer",
      "options": {
        "baseURL": "http://127.0.0.1:8011/v1",
        "apiKey": "local"
      },
      "models": {
        "Qwen/Qwen3.5-9B": {
          "name": "Qwen3.5-9B",
          "limit": {
            "context": 8192,
            "output": 512
          }
        }
      }
    }
  },
  "agent": {
    "prompt-improver": {
      "mode": "primary",
      "prompt": "{file:./improver.txt}",
      "steps": 4,
      "tools": {
        "*": false,
        "write_prompt": true,
        "run": true
      },
      "permission": {
        "*": "deny",
        "write_prompt": "allow",
        "run": "allow"
      },
      "temperature": 0
    }
  }
}
