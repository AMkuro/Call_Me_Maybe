...@workflow-style
direction: down

process_prompt: "process_prompt (pipeline)" {
  style.fill: "#E4E9FE"
  input: "user_prompt・functions・model・trie・vocab を受け取る"
  select_name: "1. select_name (pipeline)\n全関数から呼び出す関数を選ぶ\n詳細: 関数名の選択図"
  generate_parameters: "2. generate_parameters (pipeline)\n選んだ関数の引数を生成する\n詳細: 引数生成図"

  validate_call: "3. validate_call (pipeline)" {
    style.fill: "#E4E9FE"
    parse: "json.loads\n生成した JSON 全文をパースする"
    record: "FunctionCall.model_validate (schema)\nprompt・name・parameters を検証する"
    arguments: "build_parameters_model (schema)\n選んだ関数の引数を検証・型変換する"
    result: "検証後の parameters を持つ\n新しい FunctionCall を作る"
    invalid: "ValueError を PromptError にして送出する"
  }
  result: "FunctionCall を呼び出し元へ返す"
}
caller_error: "main (__main__)\n理由を標準エラーへ表示し\nこの1件を飛ばして次の入力へ進む"

process_prompt.input -> process_prompt.select_name
process_prompt.select_name -> process_prompt.generate_parameters: 関数定義 fn
process_prompt.generate_parameters -> process_prompt.validate_call.parse: JSON 全文 text
process_prompt.validate_call.parse -> process_prompt.validate_call.record -> process_prompt.validate_call.arguments -> process_prompt.validate_call.result -> process_prompt.result
process_prompt.validate_call.parse -> process_prompt.validate_call.invalid: JSON が不正 {
  style.stroke-dash: 3
}
process_prompt.validate_call.record -> process_prompt.validate_call.invalid: 出力の検証に失敗 {
  style.stroke-dash: 3
}
process_prompt.validate_call.arguments -> process_prompt.validate_call.invalid: 引数の検証に失敗 {
  style.stroke-dash: 3
}
process_prompt.select_name -> caller_error: PromptError {
  style.stroke-dash: 3
}
process_prompt.generate_parameters -> caller_error: PromptError {
  style.stroke-dash: 3
}
process_prompt.validate_call.invalid -> caller_error: PromptError {
  style.stroke-dash: 3
}
