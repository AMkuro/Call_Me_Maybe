...@workflow-style
direction: down

parameters: "generate_parameters (pipeline): 選んだ関数の引数を生成する" {
  label.near: top-center
  style.fill: "#E4E9FE"
  prompt: "build_parameters_prompt (prompt)\n入力: user_prompt と選んだ関数 fn\nmodel.encode で入力 IDs にする"
  head: "prompt と関数名を json.dumps でエスケープ\nJSON の先頭を text に書き、IDs にも追加する"
  skeleton: "build_skeleton (skeleton)\n強制する Forced と値の ValueSlot を順に作る"
  next: 次の部分はあるか {
    shape: diamond
  }
  kind: 部分の種類は何か {
    shape: diamond
  }
  force: "Forced.text を text に追加する\nmodel.encode した IDs も追加する"

  value: "generate_value (pipeline)" {
    label.near: top-center
    style.fill: "#E4E9FE"
    begin: "generate (decoder)\n生成列 generated を空リストで始める"
    decode: "allowed_next (generate_value 内)\nmodel.decode で生成済みの文字列を得る"
    complete: "is_value_complete (values)\n値と slot.terminator が揃ったか" {
      shape: diamond
    }
    allowed: "allowed_value_tokens (values)\n型・生成済み文字列・終端から\n許可 ID のリストを得る"
    step: "generate (decoder) で上限を確認する\n1候補は強制、複数なら logits と choose_token\n選んだ ID を生成列へ追加する"
    result: "allowed_next が None を返す\n区切りを含む生成 ID 列を返す"
    error: "PromptError を送出する\n終端に達する前に\n上限を超えた"
  }
  append: "生成した値と区切りを text に追加する\n生成 IDs も入力列へ追加する"
  result: 組み立てた JSON 全文を返す
}

parameters.prompt -> parameters.head -> parameters.skeleton -> parameters.next
parameters.next -> parameters.kind: ある
parameters.kind -> parameters.force: Forced
parameters.force -> parameters.next
parameters.kind -> parameters.value.begin: ValueSlot
parameters.value.begin -> parameters.value.decode -> parameters.value.complete
parameters.value.complete -> parameters.value.result: はい
parameters.value.complete -> parameters.value.allowed: いいえ
parameters.value.allowed -> parameters.value.step -> parameters.value.decode
parameters.value.step -> parameters.value.error: 上限に達した {
  style.stroke-dash: 3
}
parameters.value.result -> parameters.append -> parameters.next
parameters.next -> parameters.result: ない

# TALA の座標指定で読み順と列位置を固定する。
parameters.value.begin.top: 0
parameters.value.begin.left: 100
parameters.value.decode.top: 126
parameters.value.decode.left: 86
parameters.value.complete.top: 252
parameters.value.complete.left: 0
parameters.value.allowed.top: 424
parameters.value.allowed.left: 122
parameters.value.step.top: 568
parameters.value.step.left: 68
parameters.value.result.top: 712
parameters.value.result.left: 0
parameters.value.error.top: 712
parameters.value.error.left: 383
parameters.prompt.top: 0
parameters.prompt.left: 182
parameters.head.top: 144
parameters.head.left: 124
parameters.skeleton.top: 270
parameters.skeleton.left: 132
parameters.next.top: 396
parameters.next.left: 168
parameters.kind.top: 532
parameters.kind.left: 168
parameters.force.top: 668
parameters.force.left: 188
parameters.value.top: 794
parameters.value.left: 0
parameters.append.top: 1770
parameters.append.left: 150
parameters.result.top: 1896
parameters.result.left: 202
vars: {
  d2-config: {
    layout-engine: tala
    pad: 24
    data: {
      tala-seeds: [
        1
      ]
    }
  }
}
